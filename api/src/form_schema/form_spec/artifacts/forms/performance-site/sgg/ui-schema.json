          },
          {
            "type": "field",
            "definition": "/properties/additionalSites/items/properties/samUei"
          },
          {
            "type": "field",
            "definition": "/properties/additionalSites/items/properties/address/properties/street1"
          },
          {
            "type": "field",
            "definition": "/properties/additionalSites/items/properties/address/properties/street2"
          },
          {
            "type": "field",
            "definition": "/properties/additionalSites/items/properties/address/properties/city"
          },
          {
            "type": "field",
            "definition": "/properties/additionalSites/items/properties/address/properties/county"
