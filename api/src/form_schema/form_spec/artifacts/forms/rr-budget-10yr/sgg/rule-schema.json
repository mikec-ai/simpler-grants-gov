{
  "budgetJustificationAttachment": {
    "gg_validation": {
      "rule": "attachment"
    }
  },
  "budgetYear": {
    "gg_type": "array",
    "equipment": {
      "additionalEquipmentsAttachment": {
        "gg_validation": {
          "rule": "attachment"
        }
      },
      "totalFund": {
        "gg_pre_population": {
          "rule": "sum_monetary",
          "fields": [
            "@THIS.equipmentList[*].fundsRequested",
            "@THIS.totalFundForAttachedEquipment"
          ],
          "materialize": "when_any_source_present",
          "presence_fields": [
            "@THIS.equipmentList[*].fundsRequested",
            "@THIS.totalFundForAttachedEquipment"
          ],
          "order": 7
        }
      }
    },
    "keyPersons": {
      "attachedKeyPersons": {
        "gg_validation": {
          "rule": "attachment"
        }
      },
      "keyPerson": {
        "gg_type": "array",
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 1
          }
        }
      },
      "totalFundForKeyPersons": {
        "gg_pre_population": {
          "rule": "sum_monetary",
          "fields": [
            "@THIS.keyPerson[*].fundsRequested",
            "@THIS.totalFundForAttachedKeyPersons"
          ],
          "order": 9
        }
      }
    },
    "otherPersonnel": {
      "other": {
        "gg_type": "array",
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "materialize": "when_any_source_present",
            "presence_fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 6
          }
        }
      },
      "graduateStudents": {
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "materialize": "when_any_source_present",
            "presence_fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 3
          }
        }
      },
      "otherPersonnelTotalNumber": {
        "gg_pre_population": {
          "rule": "sum_integer",
          "fields": [
            "@THIS.postDocAssociates.numberOfPersonnel",
            "@THIS.graduateStudents.numberOfPersonnel",
            "@THIS.undergraduateStudents.numberOfPersonnel",
            "@THIS.secretarialClerical.numberOfPersonnel",
            "@THIS.other[*].numberOfPersonnel"
          ],
          "order": 11
        }
      },
      "postDocAssociates": {
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "materialize": "when_any_source_present",
            "presence_fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 2
          }
        }
      },
      "secretarialClerical": {
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "materialize": "when_any_source_present",
            "presence_fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 5
          }
        }
      },
      "totalOtherPersonnelFund": {
        "gg_pre_population": {
          "rule": "sum_monetary",
          "fields": [
            "@THIS.postDocAssociates.fundsRequested",
            "@THIS.graduateStudents.fundsRequested",
            "@THIS.undergraduateStudents.fundsRequested",
            "@THIS.secretarialClerical.fundsRequested",
