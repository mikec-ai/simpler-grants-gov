            "@THIS.materialsSupplies",
            "@THIS.publicationCosts",
            "@THIS.consultantServices",
            "@THIS.adpComputerServices",
            "@THIS.subawardConsortiumContractualCosts",
            "@THIS.equipmentRentalFee",
            "@THIS.alterationsRenovations",
            "@THIS.otherDirectCost1.cost",
            "@THIS.otherDirectCost2.cost",
            "@THIS.otherDirectCost3.cost",
            "@THIS.otherDirectCost4.cost",
            "@THIS.otherDirectCost5.cost",
