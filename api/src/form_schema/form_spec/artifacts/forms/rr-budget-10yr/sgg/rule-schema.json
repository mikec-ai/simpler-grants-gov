          ],
          "order": 12
        }
      },
      "undergraduateStudents": {
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
