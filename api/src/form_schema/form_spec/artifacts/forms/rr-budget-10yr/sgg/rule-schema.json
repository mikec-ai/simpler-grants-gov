      "gg_pre_population": {
        "rule": "sum_monetary",
        "fields": [
          "@THIS.keyPersons.totalFundForKeyPersons",
          "@THIS.otherPersonnel.totalOtherPersonnelFund",
          "@THIS.equipment.totalFund",
          "@THIS.travel.totalTravelCost",
