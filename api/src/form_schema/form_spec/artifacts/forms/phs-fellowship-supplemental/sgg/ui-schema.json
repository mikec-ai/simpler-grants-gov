  {
    "type": "section",
    "name": "otherResearchTrainingPlan",
    "label": "Other Research Training Plan",
    "children": [
      {
        "type": "field",
        "definition": "/properties/vertebrateAnimalsUsed"
      },
      {
        "type": "field",
        "definition": "/properties/vertebrateAnimalEuthanasia/properties/animalEuthanized",
        "conditional": {
          "when": {
            "op": "equals",
            "ref": {
              "scope": "root",
              "pointer": "/vertebrateAnimalsUsed"
            },
            "value": "Y: Yes"
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      },
      {
        "type": "field",
        "definition": "/properties/vertebrateAnimalEuthanasia/properties/avmaConsistent",
        "conditional": {
          "when": {
            "op": "all",
            "predicates": [
              {
                "op": "equals",
                "ref": {
                  "scope": "root",
                  "pointer": "/vertebrateAnimalsUsed"
                },
                "value": "Y: Yes"
              },
              {
                "op": "equals",
                "ref": {
                  "scope": "root",
                  "pointer": "/vertebrateAnimalEuthanasia/animalEuthanized"
                },
                "value": "Y: Yes"
              }
            ]
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      },
      {
        "type": "field",
        "definition": "/properties/vertebrateAnimalEuthanasia/properties/methodDescription",
        "widget": "TextArea",
        "conditional": {
          "when": {
            "op": "all",
            "predicates": [
              {
                "op": "equals",
                "ref": {
                  "scope": "root",
                  "pointer": "/vertebrateAnimalsUsed"
                },
                "value": "Y: Yes"
              },
              {
                "op": "equals",
                "ref": {
                  "scope": "root",
                  "pointer": "/vertebrateAnimalEuthanasia/avmaConsistent"
                },
                "value": "N: No"
              }
            ]
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      },
      {
        "type": "field",
        "definition": "/properties/vertebrateAnimalsDocument",
        "widget": "Attachment"
