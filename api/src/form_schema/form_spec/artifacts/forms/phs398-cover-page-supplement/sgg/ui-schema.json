[
  {
    "type": "section",
    "name": "vertebrateAnimals",
    "label": "1. Vertebrate Animals",
    "children": [
      {
        "type": "field",
        "definition": "/properties/vertebrateAnimals/properties/animalEuthanized"
      },
      {
        "type": "field",
        "definition": "/properties/vertebrateAnimals/properties/avmaConsistent",
        "conditional": {
          "when": {
            "op": "equals",
            "ref": {
              "scope": "root",
              "pointer": "/vertebrateAnimals/animalEuthanized"
            },
            "value": "Y: Yes"
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      },
      {
        "type": "field",
        "definition": "/properties/vertebrateAnimals/properties/methodDescription",
        "widget": "TextArea",
        "conditional": {
          "when": {
            "op": "equals",
            "ref": {
              "scope": "root",
              "pointer": "/vertebrateAnimals/avmaConsistent"
            },
            "value": "N: No"
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      }
    ]
  },
