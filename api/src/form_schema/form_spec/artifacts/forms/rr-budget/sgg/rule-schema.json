{
  "budgetJustificationAttachment": {
    "gg_validation": {
      "rule": "attachment"
    }
  },
  "budgetYear": {
    "gg_type": "array",
    "equipment": {
      "additionalEquipmentsAttachment": {
        "gg_validation": {
          "rule": "attachment"
        }
      }
    },
    "keyPersons": {
      "attachedKeyPersons": {
        "gg_validation": {
          "rule": "attachment"
        }
      },
      "keyPerson": {
        "gg_type": "array",
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 1
          }
        }
      }
    },
    "otherPersonnel": {
      "other": {
        "gg_type": "array",
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 6
          }
        }
      },
      "graduateStudents": {
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 3
          }
        }
      },
      "postDocAssociates": {
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 2
          }
        }
      },
      "secretarialClerical": {
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 5
          }
        }
      },
      "undergraduateStudents": {
        "fundsRequested": {
          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.requestedSalary",
              "@THIS.fringeBenefits"
            ],
            "order": 4
          }
        }
      }
    },
    "totalCompensation": {
      "gg_pre_population": {
        "rule": "sum_monetary",
        "fields": [
          "@THIS.keyPersons.totalFundForKeyPersons",
          "@THIS.otherPersonnel.totalOtherPersonnelFund"
        ],
        "order": 7
      }
    },
    "totalCosts": {
      "gg_pre_population": {
        "rule": "sum_monetary",
        "fields": [
          "@THIS.directCosts",
          "@THIS.indirectCosts.totalIndirectCosts"
        ],
        "order": 9
      }
    },
    "totalCostsFee": {
      "gg_pre_population": {
        "rule": "sum_monetary",
        "fields": [
          "@THIS.totalCosts",
          "@THIS.fee"
        ],
        "order": 10
      }
    },
    "travel": {
      "totalTravelCost": {
        "gg_pre_population": {
          "rule": "sum_monetary",
          "fields": [
            "@THIS.domesticTravelCost",
            "@THIS.foreignTravelCost"
          ],
          "order": 8
        }
      }
    }
  },
  "budgetSummary": {
