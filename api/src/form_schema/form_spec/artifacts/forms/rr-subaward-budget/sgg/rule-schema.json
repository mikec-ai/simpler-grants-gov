          "gg_pre_population": {
            "rule": "sum_monetary",
            "fields": [
              "@THIS.domesticTravelCost",
              "@THIS.foreignTravelCost"
            ],
            "order": 8
          }
        }
      }
    },
    "budgetSummary": {
