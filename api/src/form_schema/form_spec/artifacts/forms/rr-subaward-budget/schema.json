{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rr-subaward-budget/schema.json",
  "type": "object",
  "properties": {
    "budgetAttachments": {
      "type": "array",
      "items": {
        "$ref": "../../question-bank/budget/research/details/schema.json",
        "properties": {
          "budgetYear": {
            "items": {
              "properties": {
                "directCosts": {
                  "readOnly": true
                },
                "equipment": {
                  "properties": {
                    "totalFund": {
                      "readOnly": true
                    },
                    "additionalEquipmentsAttachment": {
                      "description": "One possible attachment per budget period. Required if TotalFundForAttachedEquipment is entered and greater than zero."
                    },
                    "totalFundForAttachedEquipment": {
                      "description": "Required and must be greater than zero if an AdditionalEquipmentsAttachment exists."
                    }
                  }
                },
                "indirectCosts": {
                  "properties": {
                    "totalIndirectCosts": {
                      "readOnly": true
                    }
                  }
                },
                "keyPersons": {
                  "properties": {
                    "keyPerson": {
                      "items": {
                        "properties": {
                          "fundsRequested": {
                            "readOnly": true
                          }
                        }
                      }
                    },
                    "totalFundForKeyPersons": {
                      "readOnly": true
                    },
                    "attachedKeyPersons": {
                      "description": "One possible attachment per budget period. Required if TotalFundForAttachedKeyPersons is entered and greater than zero."
                    },
                    "totalFundForAttachedKeyPersons": {
                      "description": "Required and must be greater than zero if an AttachedKeyPersons attachment exists."
                    }
                  }
                },
                "otherDirectCosts": {
                  "properties": {
                    "totalOtherDirectCost": {
                      "readOnly": true
                    }
                  }
                },
                "otherPersonnel": {
                  "properties": {
                    "graduateStudents": {
                      "properties": {
                        "fundsRequested": {
                          "readOnly": true
                        },
                        "projectRole": {
                          "readOnly": true
                        }
                      }
                    },
                    "other": {
                      "items": {
                        "properties": {
                          "fundsRequested": {
                            "readOnly": true
                          }
                        }
                      }
                    },
                    "otherPersonnelTotalNumber": {
                      "readOnly": true
                    },
                    "postDocAssociates": {
                      "properties": {
                        "fundsRequested": {
                          "readOnly": true
                        },
                        "projectRole": {
                          "readOnly": true
                        }
                      }
                    },
                    "secretarialClerical": {
                      "properties": {
                        "fundsRequested": {
                          "readOnly": true
                        },
                        "projectRole": {
                          "readOnly": true
                        }
                      }
                    },
                    "totalOtherPersonnelFund": {
                      "readOnly": true
                    },
                    "undergraduateStudents": {
                      "properties": {
                        "fundsRequested": {
                          "readOnly": true
                        },
                        "projectRole": {
                          "readOnly": true
                        }
                      }
                    }
                  }
                },
                "participantTraineeSupportCosts": {
                  "properties": {
                    "totalCost": {
                      "readOnly": true
                    }
                  }
                },
                "totalCompensation": {
                  "readOnly": true
                },
                "totalCosts": {
                  "readOnly": true
                },
                "totalCostsFee": {
                  "readOnly": true
                },
                "travel": {
                  "properties": {
                    "totalTravelCost": {
                      "readOnly": true
                    }
                  }
                },
                "budgetPeriodEndDate": {
                  "description": "End Date cannot be before Start Date."
                }
              }
            }
          },
          "budgetSummary": {
            "properties": {
              "cumulativeAdpComputerServices": {
                "readOnly": true
              },
              "cumulativeAlterationsAndRenovations": {
                "readOnly": true
              },
              "cumulativeConsultantServices": {
                "readOnly": true
              },
              "cumulativeDomesticTravelCosts": {
                "readOnly": true
              },
              "cumulativeEquipmentFacilityRentalFees": {
                "readOnly": true
              },
              "cumulativeFee": {
                "readOnly": true
              },
              "cumulativeForeignTravelCosts": {
                "readOnly": true
              },
              "cumulativeMaterialAndSupplies": {
                "readOnly": true
              },
              "cumulativeNoofTrainees": {
                "readOnly": true
              },
              "cumulativeOther10DirectCost": {
                "readOnly": true
              },
              "cumulativeOther1DirectCost": {
                "readOnly": true
              },
              "cumulativeOther2DirectCost": {
                "readOnly": true
              },
              "cumulativeOther3DirectCost": {
                "readOnly": true
              },
              "cumulativeOther4DirectCost": {
                "readOnly": true
              },
              "cumulativeOther5DirectCost": {
                "readOnly": true
              },
              "cumulativeOther6DirectCost": {
                "readOnly": true
              },
              "cumulativeOther7DirectCost": {
                "readOnly": true
              },
              "cumulativeOther8DirectCost": {
                "readOnly": true
              },
              "cumulativeOther9DirectCost": {
                "readOnly": true
              },
              "cumulativeOtherTraineeCost": {
                "readOnly": true
              },
              "cumulativePublicationCosts": {
                "readOnly": true
              },
              "cumulativeSubawardConsortiumContractualCosts": {
                "readOnly": true
              },
              "cumulativeTotalCostsFee": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedDirectCosts": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedDirectIndirectCosts": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedEquipment": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedIndirectCost": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedOtherDirectCosts": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedOtherPersonnel": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedPersonnel": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedSeniorKeyPerson": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedTraineeCosts": {
                "readOnly": true
              },
              "cumulativeTotalFundsRequestedTravel": {
                "readOnly": true
              },
              "cumulativeTotalNoOtherPersonnel": {
                "readOnly": true
              },
              "cumulativeTraineeStipends": {
                "readOnly": true
              },
              "cumulativeTraineeSubsistence": {
                "readOnly": true
              },
              "cumulativeTraineeTravel": {
                "readOnly": true
              },
              "cumulativeTraineeTuitionFeesHealthInsurance": {
                "readOnly": true
              }
            }
          }
        }
      },
      "maxItems": 10,
      "description": "Add up to ten structured Research & Related budgets for subaward organizations.",
      "title": "Subaward Budgets"
    }
  },
  "description": "R&R Subaward Budget Attachment(s) Form, Grants.gov form version 3.0."
}
