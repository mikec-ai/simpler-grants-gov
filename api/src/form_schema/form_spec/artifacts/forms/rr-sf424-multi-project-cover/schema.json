      "$ref": "../../question-bank/application/pre-application-document/schema.json",
      "title": "Pre-application"
    },
    "coverLetterAttachment": {
      "$ref": "../../question-bank/application/cover-letter/schema.json",
      "title": "Cover Letter"
    }
