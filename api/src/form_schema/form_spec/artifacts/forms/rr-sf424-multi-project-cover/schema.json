    "submissionTypeCode": {
      "$ref": "#/$defs/ResearchSubmissionType",
      "title": "Type of Submission"
    },
    "submittedDate": {
      "type": "string",
      "format": "date",
      "title": "Date Submitted"
    },
    "applicantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "title": "Applicant Identifier"
    },
    "stateReceivedDate": {
      "type": "string",
      "format": "date",
      "title": "State Received Date"
    },
    "stateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "title": "State Application Identifier"
    },
    "federalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "title": "Federal Identifier"
    },
    "agencyRoutingNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 75,
      "title": "Agency Routing Number"
    },
    "grantsTrackingNumber": {
      "type": "string",
      "minLength": 13,
      "maxLength": 15,
      "title": "Grants.gov Identifier"
