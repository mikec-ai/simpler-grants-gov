{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rr-sf424-multi-project-cover/schema.json",
  "type": "object",
  "properties": {
    "submissionTypeCode": {
      "$ref": "#/$defs/ResearchSubmissionType",
      "title": "Type of Submission"
    },
    "submittedDate": {
      "$ref": "../../question-bank/application/submission-date-entered/schema.json",
      "title": "Date Submitted"
    },
    "applicantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "title": "Applicant Identifier"
    },
    "stateReceivedDate": {
      "$ref": "../../question-bank/application/state-received-date/schema.json",
      "title": "State Received Date"
    },
    "stateId": {
      "$ref": "../../question-bank/application/state-application-identifier/schema.json",
      "minLength": 1,
      "maxLength": 30,
      "title": "State Application Identifier"
    },
    "federalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "title": "Federal Identifier"
    },
    "agencyRoutingNumber": {
      "$ref": "../../question-bank/application/federal-agency-routing-number/schema.json",
      "minLength": 1,
      "maxLength": 75,
      "title": "Agency Routing Number"
    },
    "grantsTrackingNumber": {
      "$ref": "../../question-bank/application/previous-grants-gov-tracking-number/schema.json",
      "minLength": 13,
      "maxLength": 15,
      "title": "Grants.gov Identifier"
    },
    "applicantInfo": {
      "$ref": "#/$defs/MultiProjectApplicant",
      "title": "Applicant Information"
    },
    "employerId": {
      "$ref": "../../question-bank/primary-org/ein/schema.json",
      "title": "Employer Identification Number"
    },
    "applicantType": {
      "$ref": "#/$defs/MultiProjectApplicantType",
      "title": "Type of Applicant"
    },
    "applicationType": {
      "$ref": "#/$defs/MultiProjectApplicationType",
      "title": "Type of Application",
      "properties": {
        "revisionCode": {
          "x-encoded-checkbox-group": {
            "choices": [
              {
                "code": "A",
                "label": "A. Increase Award"
              },
              {
                "code": "B",
                "label": "B. Decrease Award"
              },
              {
                "code": "C",
                "label": "C. Increase Duration"
              },
              {
                "code": "D",
                "label": "D. Decrease Duration"
              },
              {
                "code": "E",
                "label": "E. Other"
              }
            ],
            "combinations": [
              {
                "value": "A",
                "members": [
                  "A"
                ]
              },
              {
                "value": "B",
                "members": [
                  "B"
                ]
              },
              {
                "value": "C",
                "members": [
                  "C"
                ]
              },
              {
                "value": "D",
                "members": [
                  "D"
                ]
              },
              {
                "value": "E",
                "members": [
                  "E"
                ]
              },
              {
                "value": "AC",
                "members": [
                  "A",
                  "C"
                ]
              },
              {
                "value": "AD",
                "members": [
                  "A",
                  "D"
                ]
              },
              {
                "value": "BC",
                "members": [
                  "B",
                  "C"
                ]
              },
              {
                "value": "BD",
                "members": [
                  "B",
                  "D"
                ]
              }
            ]
          }
        }
      }
    },
    "federalAgencyName": {
      "$ref": "../../question-bank/opportunity/agency-name/schema.json",
      "title": "Federal Agency Name"
    },
    "assistanceListingNumber": {
      "$ref": "../../question-bank/opportunity/assistance-listing-number/schema.json",
      "title": "Assistance Listing Number"
    },
    "activityTitle": {
      "$ref": "../../question-bank/opportunity/assistance-listing-title/schema.json",
      "title": "Assistance Listing Title"
    },
    "projectTitle": {
      "$ref": "../../question-bank/project/title/schema.json",
      "title": "Project Title",
      "maxLength": 200
    },
    "proposedProjectPeriod": {
      "$ref": "#/$defs/MultiProjectPeriod",
      "title": "Proposed Project Period"
    },
    "applicantCongressionalDistrict": {
      "$ref": "../../question-bank/project/congressional-district/schema.json",
      "title": "Applicant Congressional District",
      "pattern": "^(?:[A-Z]{2}|00)-[0-9]{3}$"
    },
    "principalInvestigator": {
      "$ref": "#/$defs/MultiProjectPrincipalInvestigator",
      "title": "Project Director / Principal Investigator"
    },
    "estimatedProjectFunding": {
      "$ref": "#/$defs/MultiProjectEstimatedFunding",
      "title": "Estimated Project Funding"
    },
    "stateReview": {
      "$ref": "#/$defs/MultiProjectStateReview",
      "title": "State Review"
    },
    "trustAgree": {
      "$ref": "#/$defs/AffirmativeCertification",
      "title": "I agree"
    },
    "sflllAttachment": {
      "$ref": "../../question-bank/application/disclosure-document/schema.json",
      "title": "SF-LLL or Other Explanatory Documentation"
    },
    "authorizedRepresentative": {
      "$ref": "#/$defs/MultiProjectAuthorizedRepresentative",
      "title": "Authorized Representative"
    },
    "aorSignature": {
      "$ref": "#/$defs/MultiProjectSignature",
      "minLength": 1,
      "maxLength": 144,
      "title": "Signature of Authorized Representative"
    },
    "aorSignedDate": {
      "type": "string",
      "format": "date",
      "title": "Date Signed"
    },
    "preApplicationAttachment": {
      "$ref": "../../question-bank/application/pre-application-document/schema.json",
      "title": "Pre-application"
    },
    "coverLetterAttachment": {
      "$ref": "../../question-bank/application/cover-letter/schema.json",
      "title": "Cover Letter"
    }
  },
  "description": "Research & Related Multi-Project Cover, Grants.gov form version 4.0.",
  "$defs": {
    "ResearchSubmissionType": {
      "type": "string",
      "enum": [
        "Preapplication",
        "Application",
        "Change/Corrected Application"
      ]
    },
    "StateCode": {
      "type": "string",
      "enum": [
        "AL: Alabama",
        "AK: Alaska",
        "AZ: Arizona",
        "AR: Arkansas",
        "CA: California",
        "CO: Colorado",
        "CT: Connecticut",
        "DE: Delaware",
        "DC: District of Columbia",
        "FL: Florida",
        "GA: Georgia",
        "HI: Hawaii",
        "ID: Idaho",
        "IL: Illinois",
        "IN: Indiana",
        "IA: Iowa",
        "KS: Kansas",
        "KY: Kentucky",
        "LA: Louisiana",
        "ME: Maine",
        "MD: Maryland",
        "MA: Massachusetts",
        "MI: Michigan",
        "MN: Minnesota",
        "MS: Mississippi",
        "MO: Missouri",
        "MT: Montana",
        "NE: Nebraska",
        "NV: Nevada",
        "NH: New Hampshire",
        "NJ: New Jersey",
        "NM: New Mexico",
        "NY: New York",
        "NC: North Carolina",
        "ND: North Dakota",
        "OH: Ohio",
        "OK: Oklahoma",
        "OR: Oregon",
        "PA: Pennsylvania",
        "RI: Rhode Island",
        "SC: South Carolina",
        "SD: South Dakota",
        "TN: Tennessee",
        "TX: Texas",
        "UT: Utah",
        "VT: Vermont",
        "VA: Virginia",
        "WA: Washington",
        "WV: West Virginia",
        "WI: Wisconsin",
        "WY: Wyoming",
        "AS: American Samoa",
        "FM: Federated States of Micronesia",
        "GU: Guam",
        "MH: Marshall Islands",
        "MP: Northern Mariana Islands",
        "PW: Palau",
        "PR: Puerto Rico",
        "VI: Virgin Islands",
        "FQ: Baker Island",
        "HQ: Howland Island",
        "DQ: Jarvis Island",
        "JQ: Johnston Atoll",
        "KQ: Kingman Reef",
        "MQ: Midway Islands",
        "BQ: Navassa Island",
        "LQ: Palmyra Atoll",
        "WQ: Wake Island",
        "AA: Armed Forces Americas (except Canada)",
        "AE: Armed Forces Europe, the Middle East, and Canada",
        "AP: Armed Forces Pacific"
      ],
      "description": "US State or Territory Code",
      "title": "State"
    },
    "MultiProjectCountryControlledAddress": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/StateCode",
          "title": "State"
        },
        "province": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "title": "Province"
        }
      },
      "allOf": [
        {
          "$ref": "../../question-bank/generics/address/schema.json"
        }
      ]
    },
    "ResearchApplicantOrganization": {
      "type": "object",
      "properties": {
        "organizationName": {
          "$ref": "../../question-bank/primary-org/legal-name/schema.json",
          "description": "Enter the applicant organization's legal name.",
          "title": "Organization Name"
        },
        "address": {
          "$ref": "../../question-bank/generics/address/schema.json",
          "description": "Enter the applicant organization's address.",
          "title": "Address"
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Enter the department.",
          "title": "Department"
        },
        "division": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Enter the division.",
          "title": "Division"
        },
        "samUei": {
          "$ref": "../../question-bank/primary-org/uei/schema.json",
          "description": "The applicant organization's Unique Entity Identifier.",
          "title": "SAM UEI"
        },
        "employerId": {
          "type": "string",
          "minLength": 9,
          "maxLength": 30
        }
      },
      "description": "The applicant organization information required by an R&R cover form."
    },
    "MultiProjectApplicantOrganization": {
      "type": "object",
      "properties": {
        "address": {
          "$ref": "#/$defs/MultiProjectCountryControlledAddress"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/ResearchApplicantOrganization"
        }
      ]
    },
    "ResearchApplicationContact": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "../../question-bank/generics/person-name/schema.json",
          "description": "Enter the contact person's name.",
          "title": "Name"
        },
        "address": {
          "$ref": "../../question-bank/generics/address/schema.json",
          "description": "Enter the contact person's address.",
          "title": "Address"
        },
        "title": {
          "$ref": "../../question-bank/generics/contact-title/schema.json",
          "description": "Enter the contact person's title.",
          "title": "Title"
        },
        "phone": {
          "$ref": "../../question-bank/generics/phone/schema.json",
          "description": "Enter the daytime telephone number.",
          "title": "Telephone Number"
        },
        "fax": {
          "$ref": "../../question-bank/generics/phone/schema.json",
          "description": "Enter the fax number.",
          "title": "Fax Number"
        },
        "email": {
          "$ref": "../../question-bank/generics/email/schema.json",
          "description": "Enter a valid email address.",
          "title": "Email"
        }
      },
      "description": "The person to contact about the Research and Related application."
    },
    "MultiProjectApplicationContact": {
      "type": "object",
      "properties": {
        "address": {
          "$ref": "#/$defs/MultiProjectCountryControlledAddress"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/ResearchApplicationContact"
        }
      ]
    },
    "MultiProjectApplicant": {
      "type": "object",
      "properties": {
        "organizationInfo": {
          "$ref": "#/$defs/MultiProjectApplicantOrganization"
        },
        "contactPersonInfo": {
          "$ref": "#/$defs/MultiProjectApplicationContact"
        }
      },
      "allOf": [
        {
          "$ref": "../../question-bank/research-application/applicant/schema.json"
        }
      ]
    },
    "ApplicantTypeCode": {
      "type": "string",
      "enum": [
        "A: State Government",
        "B: County Government",
        "C: City or Township Government",
        "D: Special District Government",
        "E: Regional Organization",
        "F: U.S. Territory or Possession",
        "G: Independent School District",
        "H: Public/state Controlled Institution of Higher Education",
        "I: Indian/Native American Tribal Government (Federally Recognized)",
        "J: Indian/Native American Tribal Government (Other than Federally Recognized)",
        "K: Indian/Native American Tribally Designated Organization",
        "L: Public/Indian Housing Authority",
        "M: Nonprofit with 501C3 IRS Status (Other than Institution of Higher Education)",
        "N: Nonprofit without 501C3 IRS Status (Other than Institution of Higher Education)",
        "O: Private Institution of Higher Education",
        "P: Individual",
        "Q: For-Profit Organization (Other than Small Business)",
        "R: Small Business",
        "S: Hispanic-serving Institution",
        "T: Historically Black Colleges and Universities (HBCUs)",
        "U: Tribally Controlled Colleges and Universities (TCCUs)",
        "V: Alaska Native and Native Hawaiian Serving Institutions",
        "W: Non-domestic (non-US) Entity",
        "X: Other (specify)"
      ],
      "description": "The applicant's category, from the Executive Order 12372 list.",
      "title": "Type of Applicant"
    },
    "ResearchSmallBusinessType": {
      "type": "object",
      "properties": {
        "sociallyEconomicallyDisadvantaged": {
          "type": "string",
          "title": "Socially and Economically Disadvantaged"
        },
        "womenOwned": {
          "type": "string",
          "title": "Women Owned"
        }
      }
    },
    "MultiProjectApplicantType": {
      "type": "object",
      "properties": {
        "applicantTypeCode": {
          "$ref": "#/$defs/ApplicantTypeCode",
          "title": "Applicant Type"
        },
        "applicantTypeCodeOtherExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "title": "Other Applicant Type Explanation"
        },
        "smallBusinessOrganizationType": {
          "$ref": "#/$defs/ResearchSmallBusinessType",
          "title": "Small Business Organization Type"
        }
      }
    },
    "ResearchApplicationTypeCode": {
      "type": "string",
      "enum": [
        "New",
        "Resubmission",
        "Renewal",
        "Continuation",
        "Revision"
      ]
    },
    "YesNoCode": {
      "type": "string",
      "enum": [
        "Y: Yes",
        "N: No"
      ]
    },
    "ResearchRevisionCode": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "AC",
        "AD",
        "BC",
        "BD"
      ]
    },
    "MultiProjectApplicationType": {
      "type": "object",
      "properties": {
        "applicationTypeCode": {
          "$ref": "#/$defs/ResearchApplicationTypeCode",
          "title": "Application Type"
        },
        "isOtherAgencySubmission": {
          "$ref": "#/$defs/YesNoCode",
          "title": "Is this application being submitted to another agency?"
        },
        "otherAgencySubmissionExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "title": "Other Agency Submission Explanation"
        },
        "revisionCode": {
          "$ref": "#/$defs/ResearchRevisionCode",
          "title": "Revision Code",
          "x-encoded-checkbox-group": {
            "choices": [
              {
                "code": "A",
                "label": "A. Increase Award"
              },
              {
                "code": "B",
                "label": "B. Decrease Award"
              },
              {
                "code": "C",
                "label": "C. Increase Duration"
              },
              {
                "code": "D",
                "label": "D. Decrease Duration"
              },
              {
                "code": "E",
                "label": "E. Other"
              }
            ],
            "combinations": [
              {
                "value": "A",
                "members": [
                  "A"
                ]
              },
              {
                "value": "B",
                "members": [
                  "B"
                ]
              },
              {
                "value": "C",
                "members": [
                  "C"
                ]
              },
              {
                "value": "D",
                "members": [
                  "D"
                ]
              },
              {
                "value": "E",
                "members": [
                  "E"
                ]
              },
              {
                "value": "AC",
                "members": [
                  "A",
                  "C"
                ]
              },
              {
                "value": "AD",
                "members": [
                  "A",
                  "D"
                ]
              },
              {
                "value": "BC",
                "members": [
                  "B",
                  "C"
                ]
              },
              {
                "value": "BD",
                "members": [
                  "B",
                  "D"
                ]
              }
            ]
          }
        },
        "revisionCodeOtherExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 45,
          "title": "Other Revision Explanation"
        }
      }
    },
    "MultiProjectPeriod": {
      "type": "object",
      "properties": {
        "proposedStartDate": {
          "$ref": "../../question-bank/project/start-date/schema.json",
          "title": "Proposed Start Date"
        },
        "proposedEndDate": {
          "$ref": "../../question-bank/project/end-date/schema.json",
          "title": "Proposed End Date"
        }
      }
    },
    "MultiProjectProvinceControlledAddress": {
      "type": "object",
      "properties": {
        "province": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "title": "Province"
        }
      },
      "allOf": [
        {
          "$ref": "../../question-bank/generics/address/schema.json"
        }
      ]
    },
    "MultiProjectPrincipalInvestigator": {
      "type": "object",
      "properties": {
        "address": {
          "$ref": "#/$defs/MultiProjectProvinceControlledAddress"
        }
      },
      "allOf": [
        {
          "$ref": "../../question-bank/research-application/principal-investigator/schema.json"
        }
      ]
    },
    "MultiProjectEstimatedFunding": {
      "type": "object",
      "properties": {
        "totalEstimatedAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 9999999999999.99,
          "title": "Total Federal Funds Requested"
        },
        "totalNonFederalRequested": {
          "type": "number",
          "minimum": 0,
          "maximum": 9999999999999.99,
          "title": "Total Non-Federal Funds"
        },
        "totalFederalNonFederalRequested": {
          "type": "number",
          "minimum": 0,
          "maximum": 9999999999999.99,
          "title": "Total Federal and Non-Federal Funds"
        },
        "estimatedProgramIncome": {
          "type": "number",
          "minimum": 0,
          "maximum": 9999999999999.99,
          "title": "Estimated Program Income"
        }
      }
    },
    "ResearchStateReviewCode": {
      "type": "string",
      "enum": [
        "Y: Yes",
        "Program is not covered by E.O. 12372",
        "Program has not been selected by state for review"
      ]
    },
    "MultiProjectStateReview": {
      "type": "object",
      "properties": {
        "stateReviewCodeType": {
          "$ref": "#/$defs/ResearchStateReviewCode",
          "title": "State Review"
        },
        "stateReviewDate": {
          "type": "string",
          "format": "date",
          "title": "State Review Date"
        }
      }
    },
    "AffirmativeCertification": {
      "type": "string",
      "enum": [
        "Y: Yes"
      ]
    },
    "MultiProjectAuthorizedRepresentative": {
      "type": "object",
      "properties": {
        "address": {
          "$ref": "#/$defs/MultiProjectCountryControlledAddress"
        }
      },
      "allOf": [
        {
          "$ref": "../../question-bank/research-application/authorized-representative/schema.json"
        }
      ]
    },
    "MultiProjectSignature": {
      "type": "string"
    }
  }
}
