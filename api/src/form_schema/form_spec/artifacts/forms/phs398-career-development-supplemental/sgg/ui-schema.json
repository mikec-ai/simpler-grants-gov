  {
    "type": "section",
    "name": "citizenship",
    "label": "Citizenship",
    "children": [
      {
        "type": "field",
        "definition": "/properties/citizenship/properties/usCitizenOrNational"
      },
      {
        "type": "field",
        "definition": "/properties/citizenship/properties/nonUsCitizenStatus",
        "conditional": {
          "when": {
            "op": "equals",
            "ref": {
              "scope": "root",
              "pointer": "/citizenship/usCitizenOrNational"
            },
            "value": "N: No"
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      },
      {
        "type": "field",
        "definition": "/properties/citizenship/properties/permanentResidentByAward",
        "conditional": {
          "when": {
            "op": "equals",
            "ref": {
              "scope": "root",
              "pointer": "/citizenship/nonUsCitizenStatus"
            },
            "value": "Temporary U.S. Visa"
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      }
    ]
  }
]
