    "federalFundingShare": {
      "gg_pre_population": {
        "rule": "multiply_by_percentage",
        "amount": "@THIS.totalProjectCosts",
        "percentage": "@THIS.federalPercentageShare",
        "materialize": "when_any_source_present",
        "presence_fields": [
          "@THIS.totalProjectCosts",
