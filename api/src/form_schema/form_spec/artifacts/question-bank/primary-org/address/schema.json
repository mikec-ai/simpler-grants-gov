{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "primary-org/address/schema.json",
  "type": "object",
  "properties": {},
  "allOf": [
    {
      "$ref": "../../../question-bank/generics/address/schema.json"
    },
    {
      "if": {
        "properties": {
          "country": {
            "const": "USA: UNITED STATES"
          }
        },
        "required": [
          "country"
        ]
      },
      "then": {
        "required": [
          "zipCode"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "country": {
            "const": "USA: UNITED STATES"
          }
        },
        "required": [
          "country"
        ]
      },
      "then": {
        "required": [
          "state"
        ]
      }
    }
  ],
  "description": "Enter the address of the applicant.",
  "title": "Address",
  "required": [
    "street1",
    "city",
    "country"
  ]
}
