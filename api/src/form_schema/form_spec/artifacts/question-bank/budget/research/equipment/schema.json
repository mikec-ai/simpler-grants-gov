{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "budget/research/equipment/schema.json",
  "type": "object",
  "properties": {
    "additionalEquipmentsAttachment": {
      "$ref": "../../../../question-bank/budget/research/additional-equipment/schema.json",
      "title": "Additional Equipment:"
    },
    "equipmentList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResearchBudgetBudgetYearEquipmentEquipmentList"
      },
      "minItems": 0,
      "maxItems": 10
    },
    "totalFund": {
      "$ref": "#/$defs/ResearchBudgetDecimal15",
      "title": "Total Equipment",
      "readOnly": true
    },
    "totalFundForAttachedEquipment": {
      "$ref": "#/$defs/ResearchBudgetDecimal14",
      "title": "Total funds requested for all equipment listed in the attached file"
    }
  },
  "required": [
    "totalFund"
  ],
  "description": "Equipment costs for one research budget period.",
  "$defs": {
    "ResearchBudgetDecimal14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^-?(?:\\d{1,14}|\\d{1,13}[.]\\d|\\d{1,12}[.]\\d{2})$"
    },
    "ResearchBudgetBudgetYearEquipmentEquipmentList": {
      "type": "object",
      "properties": {
        "equipmentItem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "title": "Equipment Item"
        },
        "fundsRequested": {
          "$ref": "#/$defs/ResearchBudgetDecimal14",
          "title": "Equipment Item Funds Requested"
        }
      },
      "required": [
        "equipmentItem",
        "fundsRequested"
      ],
      "title": "Equipment List"
    },
    "ResearchBudgetDecimal15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 17,
      "pattern": "^-?(?:\\d{1,15}|\\d{1,14}[.]\\d|\\d{1,13}[.]\\d{2})$"
    }
  }
}
