{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "budget/research/participant-trainee-support/schema.json",
  "type": "object",
  "properties": {
    "other": {
      "$ref": "#/$defs/ResearchBudgetBudgetYearParticipantTraineeSupportCostsOther",
      "title": "Other"
    },
    "participantTraineeNumber": {
      "$ref": "#/$defs/ResearchBudgetCount3",
      "title": "Number of Participants/Trainees"
    },
    "stipends": {
      "$ref": "#/$defs/ResearchBudgetDecimal14",
      "title": "2. Stipends"
    },
    "subsistence": {
      "$ref": "#/$defs/ResearchBudgetDecimal14",
      "title": "4. Subsistence"
    },
    "totalCost": {
      "$ref": "#/$defs/ResearchBudgetDecimal15",
      "title": "Total Participant/Trainee Support Costs",
      "readOnly": true
    },
    "travel": {
      "$ref": "#/$defs/ResearchBudgetDecimal14",
      "title": "3. Travel"
    },
    "tuitionFeeHealthInsurance": {
      "$ref": "#/$defs/ResearchBudgetDecimal14",
      "title": "1. Tuition/Fees/Health Insurance"
    }
  },
  "required": [
    "totalCost"
  ],
  "description": "Participant and trainee support costs for one research budget period.",
  "$defs": {
    "ResearchBudgetDecimal14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^-?(?:\\d{1,14}|\\d{1,13}[.]\\d|\\d{1,12}[.]\\d{2})$"
    },
    "ResearchBudgetBudgetYearParticipantTraineeSupportCostsOther": {
      "type": "object",
      "properties": {
        "cost": {
          "$ref": "#/$defs/ResearchBudgetDecimal14",
          "title": "Other Participant/Trainee Costs"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "title": "5. Other"
        }
      },
      "required": [
        "cost",
        "description"
      ]
    },
    "ResearchBudgetCount3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "ResearchBudgetDecimal15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 17,
      "pattern": "^-?(?:\\d{1,15}|\\d{1,14}[.]\\d|\\d{1,13}[.]\\d{2})$"
    }
  }
}
