{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "budget/research/period/schema.json",
  "type": "object",
  "properties": {
    "budgetPeriodEndDate": {
      "type": "string",
      "format": "date",
      "title": "End Date:",
      "description": "End Date cannot be before Start Date."
    },
    "budgetPeriodStartDate": {
      "type": "string",
      "format": "date",
      "title": "Start Date:"
    },
    "cognizantFederalAgency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "title": "Cognizant Federal Agency (Agency Name, POC Name, and POC Phone Number)"
    },
    "directCosts": {
      "$ref": "#/$defs/ResearchBudgetDecimal15",
      "title": "Total Direct Costs (A thru F)",
      "readOnly": true
    },
    "equipment": {
      "$ref": "../../../../question-bank/budget/research/equipment/schema.json",
      "title": "Equipment",
      "properties": {
        "totalFund": {
          "readOnly": true
        },
        "additionalEquipmentsAttachment": {
          "description": "One possible attachment per budget period. Required if TotalFundForAttachedEquipment is entered and greater than zero."
        },
        "totalFundForAttachedEquipment": {
          "description": "Required and must be greater than zero if an AdditionalEquipmentsAttachment exists."
        }
      }
    },
    "fee": {
      "$ref": "#/$defs/ResearchBudgetAmount14",
      "title": "Fee"
    },
    "indirectCosts": {
      "$ref": "../../../../question-bank/budget/research/indirect-costs/schema.json",
      "title": "Indirect Costs",
      "properties": {
        "totalIndirectCosts": {
          "readOnly": true
        }
      }
    },
    "keyPersons": {
      "$ref": "../../../../question-bank/budget/research/key-personnel/schema.json",
      "title": "Key Persons",
      "properties": {
        "keyPerson": {
          "items": {
            "properties": {
              "fundsRequested": {
                "readOnly": true
              }
            }
          }
        },
        "totalFundForKeyPersons": {
          "readOnly": true
        },
        "attachedKeyPersons": {
          "description": "One possible attachment per budget period. Required if TotalFundForAttachedKeyPersons is entered and greater than zero."
        },
        "totalFundForAttachedKeyPersons": {
          "description": "Required and must be greater than zero if an AttachedKeyPersons attachment exists."
        }
      }
    },
    "otherDirectCosts": {
      "$ref": "../../../../question-bank/budget/research/other-direct-costs/schema.json",
      "title": "Other Direct Costs",
      "properties": {
        "totalOtherDirectCost": {
          "readOnly": true
        }
      }
    },
    "otherPersonnel": {
      "$ref": "../../../../question-bank/budget/research/other-personnel/schema.json",
      "title": "Other Personnel",
      "properties": {
        "graduateStudents": {
          "properties": {
            "fundsRequested": {
              "readOnly": true
            },
            "projectRole": {
              "readOnly": true
            }
          }
        },
        "other": {
          "items": {
            "properties": {
              "fundsRequested": {
                "readOnly": true
              }
            }
          }
        },
        "otherPersonnelTotalNumber": {
          "readOnly": true
        },
        "postDocAssociates": {
          "properties": {
            "fundsRequested": {
              "readOnly": true
            },
            "projectRole": {
              "readOnly": true
            }
          }
        },
        "secretarialClerical": {
          "properties": {
            "fundsRequested": {
              "readOnly": true
            },
            "projectRole": {
              "readOnly": true
            }
          }
        },
        "totalOtherPersonnelFund": {
          "readOnly": true
        },
        "undergraduateStudents": {
          "properties": {
            "fundsRequested": {
              "readOnly": true
            },
            "projectRole": {
              "readOnly": true
            }
          }
        }
      }
    },
    "participantTraineeSupportCosts": {
      "$ref": "../../../../question-bank/budget/research/participant-trainee-support/schema.json",
      "title": "Participant Trainee Support Costs",
      "properties": {
        "totalCost": {
          "readOnly": true
        }
      }
    },
    "totalCompensation": {
      "$ref": "#/$defs/ResearchBudgetDecimal15",
      "title": "Total Salary, Wages and Fringe Benefits (A+B)",
      "readOnly": true
    },
    "totalCosts": {
      "$ref": "#/$defs/ResearchBudgetDecimal15",
      "title": "Total Direct and Indirect Institutional Costs (G + H)",
      "readOnly": true
    },
    "totalCostsFee": {
      "$ref": "#/$defs/ResearchBudgetTotalAmount15",
      "title": "Total Costs and Fee (I + J)",
      "readOnly": true
    },
    "travel": {
      "$ref": "../../../../question-bank/budget/research/travel/schema.json",
      "title": "Travel",
      "properties": {
        "totalTravelCost": {
          "readOnly": true
        }
      }
    }
  },
  "required": [
    "budgetPeriodEndDate",
    "budgetPeriodStartDate",
    "directCosts",
    "keyPersons",
    "totalCompensation",
    "totalCosts",
    "totalCostsFee"
  ],
  "description": "A dated research budget period with personnel, direct, indirect, and total costs.",
  "title": "Budget Period",
  "$defs": {
    "ResearchBudgetDecimal15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 17,
      "pattern": "^-?(?:\\d{1,15}|\\d{1,14}[.]\\d|\\d{1,13}[.]\\d{2})$"
    },
    "ResearchBudgetAmount14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^(?:\\d{1,14}|\\d{1,13}[.]\\d|\\d{1,12}[.]\\d{2})$"
    },
    "ResearchBudgetTotalAmount15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^(?:\\d{1,15}|\\d{1,14}[.]\\d|\\d{1,13}[.]\\d{2})$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "participantTraineeSupportCosts"
        ],
        "properties": {
          "participantTraineeSupportCosts": {
            "required": [
              "other"
            ]
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost1"
                ],
                "properties": {
                  "otherDirectCost1": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost2"
                ],
                "properties": {
                  "otherDirectCost2": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost3"
                ],
                "properties": {
                  "otherDirectCost3": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost4"
                ],
                "properties": {
                  "otherDirectCost4": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost5"
                ],
                "properties": {
                  "otherDirectCost5": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost6"
                ],
                "properties": {
                  "otherDirectCost6": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost7"
                ],
                "properties": {
                  "otherDirectCost7": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost8"
                ],
                "properties": {
                  "otherDirectCost8": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost9"
                ],
                "properties": {
                  "otherDirectCost9": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "otherDirectCosts"
            ],
            "properties": {
              "otherDirectCosts": {
                "required": [
                  "otherDirectCost10"
                ],
                "properties": {
                  "otherDirectCost10": {
                    "required": [
                      "description"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
