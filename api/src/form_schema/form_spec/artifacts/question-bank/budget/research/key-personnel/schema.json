{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "budget/research/key-personnel/schema.json",
  "type": "object",
  "properties": {
    "attachedKeyPersons": {
      "$ref": "../../../../question-bank/budget/research/additional-key-personnel/schema.json",
      "title": "Additional Senior Key Persons:"
    },
    "keyPerson": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResearchBudgetBudgetYearKeyPersonsKeyPerson",
        "properties": {
          "fundsRequested": {
            "readOnly": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 8
    },
    "totalFundForAttachedKeyPersons": {
      "$ref": "#/$defs/ResearchBudgetDecimal15",
      "title": "Total Funds requested for all Senior Key Persons in the attached file"
    },
    "totalFundForKeyPersons": {
      "$ref": "#/$defs/ResearchBudgetDecimal15",
      "title": "Total Senior/Key Person",
      "readOnly": true
    }
  },
  "required": [
    "keyPerson",
    "totalFundForKeyPersons"
  ],
  "description": "Senior and key personnel compensation for one budget period.",
  "$defs": {
    "ResearchBudgetMonth2Whole2Fraction": {
      "type": "string",
      "pattern": "^-?(?:\\d{1,4}|\\d{1,3}[.]\\d|\\d{1,2}[.]\\d{2})$"
    },
    "ResearchBudgetDecimal14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^-?(?:\\d{1,14}|\\d{1,13}[.]\\d|\\d{1,12}[.]\\d{2})$"
    },
    "ResearchBudgetDecimal15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 17,
      "pattern": "^-?(?:\\d{1,15}|\\d{1,14}[.]\\d|\\d{1,13}[.]\\d{2})$"
    },
    "ResearchBudgetBudgetYearKeyPersonsKeyPersonName": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35,
          "title": "First Name"
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "title": "Last Name"
        },
        "middleName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "title": "Middle Name"
        },
        "prefixName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "title": "Prefix"
        },
        "suffixName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "title": "Suffix"
        }
      },
      "required": [
        "firstName",
        "lastName"
      ]
    },
    "ResearchBudgetBudgetYearKeyPersonsKeyPerson": {
      "type": "object",
      "properties": {
        "academicMonths": {
          "$ref": "#/$defs/ResearchBudgetMonth2Whole2Fraction",
          "title": "Senior/Key Person Academic Months"
        },
        "baseSalary": {
          "$ref": "#/$defs/ResearchBudgetDecimal14",
          "title": "Senior/Key Person Base Salary"
        },
        "calendarMonths": {
          "$ref": "#/$defs/ResearchBudgetMonth2Whole2Fraction",
          "title": "Senior/Key Person Calendar Months"
        },
        "fringeBenefits": {
          "$ref": "#/$defs/ResearchBudgetDecimal14",
          "title": "Senior/Key Person Fringe Benefits"
        },
        "fundsRequested": {
          "$ref": "#/$defs/ResearchBudgetDecimal15",
          "title": "Senior/Key Person Funds Requested",
          "readOnly": true
        },
        "name": {
          "$ref": "#/$defs/ResearchBudgetBudgetYearKeyPersonsKeyPersonName",
          "title": "Name"
        },
        "projectRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "title": "Project Role:"
        },
        "requestedSalary": {
          "$ref": "#/$defs/ResearchBudgetDecimal14",
          "title": "Senior/Key Person Requested Salary"
        },
        "summerMonths": {
          "$ref": "#/$defs/ResearchBudgetMonth2Whole2Fraction",
          "title": "Senior/Key Person Summer Months"
        }
      },
      "required": [
        "fringeBenefits",
        "fundsRequested",
        "name",
        "projectRole",
        "requestedSalary"
      ],
      "title": "Key Person"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "totalFundForAttachedKeyPersons"
        ],
        "properties": {
          "totalFundForAttachedKeyPersons": {
            "pattern": "^(?=.*[1-9])\\d+(?:\\.\\d+)?$"
          }
        }
      },
      "then": {
        "required": [
          "attachedKeyPersons"
        ]
      }
    },
    {
      "if": {
        "required": [
          "attachedKeyPersons"
        ]
      },
      "then": {
        "required": [
          "totalFundForAttachedKeyPersons"
        ],
        "properties": {
          "totalFundForAttachedKeyPersons": {
            "pattern": "^(?=.*[1-9])\\d+(?:\\.\\d+)?$"
          }
        }
      }
    }
  ]
}
