{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "budget/construction/total-project-costs/schema.json",
  "type": "object",
  "properties": {
    "totalCost": {
      "$ref": "#/$defs/ConstructionTotalAmount",
      "readOnly": true
    },
    "nonAllowableCost": {
      "$ref": "#/$defs/ConstructionTotalAmount",
      "readOnly": true
    },
    "totalAllowableCost": {
      "$ref": "#/$defs/ConstructionTotalAmount",
      "readOnly": true
    }
  },
  "description": "Total project costs after subtracting project income.",
  "title": "Total project costs",
  "$defs": {
    "ConstructionTotalAmount": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^\\d{1,12}(?:[.]\\d{2})?$",
      "description": "A non-negative calculated construction-budget subtotal."
    }
  }
}
