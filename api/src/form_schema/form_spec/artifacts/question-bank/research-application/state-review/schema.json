{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-application/state-review/schema.json",
  "type": "object",
  "properties": {
    "stateReviewCodeType": {
      "$ref": "#/$defs/ResearchStateReviewCode",
      "title": "State Review"
    },
    "stateReviewDate": {
      "type": "string",
      "format": "date",
      "title": "State Review Date"
    }
  },
  "description": "Record whether and when the R&R application was submitted for State review.",
  "$defs": {
    "ResearchStateReviewCode": {
      "type": "string",
      "enum": [
        "Y: Yes",
        "Program is not covered by E.O. 12372",
        "Program has not been selected by state for review"
      ]
    }
  }
}
