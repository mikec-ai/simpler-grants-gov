{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-project/human-subjects/schema.json",
  "type": "object",
  "properties": {
    "exemptFromFederalRegulations": {
      "$ref": "#/$defs/ResearchProjectYesNoCode",
      "description": "Is the project exempt from federal regulations governing human subjects research?",
      "title": "Is the project exempt from federal regulations?"
    },
    "exemptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HumanSubjectExemptionCode"
      },
      "minItems": 1,
      "maxItems": 8,
      "description": "Select each federal human-subject exemption that applies.",
      "title": "Exemption Number(s)"
    },
    "irbReviewPending": {
      "$ref": "#/$defs/ResearchProjectYesNoCode",
      "description": "Is institutional review board review pending?",
      "title": "Is IRB review pending?"
    },
    "irbApprovalDate": {
      "type": "string",
      "format": "date",
      "description": "Enter the institutional review board approval date.",
      "title": "IRB Approval Date"
    },
    "assuranceNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "description": "Enter the human-subject assurance number.",
      "title": "Human Subject Assurance Number"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/HumanSubjectDeterminations"
    },
    {
      "if": {
        "properties": {
          "involvesHumanSubjects": {
            "const": "Y: Yes"
          }
        },
        "required": [
          "involvesHumanSubjects"
        ]
      },
      "then": {
        "required": [
          "exemptFromFederalRegulations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "exemptFromFederalRegulations": {
            "const": "N: No"
          }
        },
        "required": [
          "exemptFromFederalRegulations"
        ]
      },
      "then": {
        "required": [
          "irbReviewPending"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "irbReviewPending": {
            "const": "N: No"
          }
        },
        "required": [
          "irbReviewPending"
        ]
      },
      "then": {
        "required": [
          "irbApprovalDate"
        ]
      }
    }
  ],
  "description": "Human-subject protections and institutional review information for the project.",
  "$defs": {
    "ResearchProjectYesNoCode": {
      "type": "string",
      "enum": [
        "Y: Yes",
        "N: No"
      ],
      "description": "The exact yes/no wire values used by the R&R Other Project Information source."
    },
    "HumanSubjectExemptionCode": {
      "type": "string",
      "enum": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6",
        "E7",
        "E8"
      ],
      "description": "Federal human-subject exemption identifiers supported by the source form."
    },
    "HumanSubjectDeterminations": {
      "type": "object",
      "properties": {
        "involvesHumanSubjects": {
          "$ref": "#/$defs/ResearchProjectYesNoCode",
          "title": "Does the proposed project involve human subjects?"
        },
        "exemptFromFederalRegulations": {
          "$ref": "#/$defs/ResearchProjectYesNoCode"
        },
        "exemptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HumanSubjectExemptionCode"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "involvesHumanSubjects"
      ]
    }
  }
}
