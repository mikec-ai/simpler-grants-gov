{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fellowship-budget/institutional-base-salary/schema.json",
  "type": "object",
  "properties": {
    "amount": {
      "$ref": "#/$defs/ResearchBudgetAmount14"
    },
    "academicPeriod": {
      "$ref": "#/$defs/FellowshipAcademicPeriod"
    },
    "numberOfMonths": {
      "$ref": "#/$defs/FellowshipMonthsUpTo24"
    }
  },
  "required": [
    "amount",
    "academicPeriod",
    "numberOfMonths"
  ],
  "description": "Enter the candidate's institutional base salary.",
  "$defs": {
    "ResearchBudgetAmount14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^(?:\\d{1,14}|\\d{1,13}[.]\\d|\\d{1,12}[.]\\d{2})$"
    },
    "FellowshipAcademicPeriod": {
      "type": "string",
      "enum": [
        "6-month",
        "9-month",
        "10-month",
        "12-month"
      ]
    },
    "FellowshipMonthsUpTo24": {
      "type": "string",
      "pattern": "^(?:[0-9]|1[0-9]|2[0-4])(?:[.][0-9]{1,2})?$"
    }
  }
}
