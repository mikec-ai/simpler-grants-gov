{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fellowship-budget/tuition/schema.json",
  "type": "object",
  "properties": {
    "fundsRequested": {
      "$ref": "#/$defs/YesNoCode",
      "title": "Tuition and Fees Requested"
    },
    "year1": {
      "$ref": "#/$defs/ResearchBudgetAmount14",
      "title": "Year 1"
    },
    "year2": {
      "$ref": "#/$defs/ResearchBudgetAmount14",
      "title": "Year 2"
    },
    "year3": {
      "$ref": "#/$defs/ResearchBudgetAmount14",
      "title": "Year 3"
    },
    "year4": {
      "$ref": "#/$defs/ResearchBudgetAmount14",
      "title": "Year 4"
    },
    "year5": {
      "$ref": "#/$defs/ResearchBudgetAmount14",
      "title": "Year 5"
    },
    "year6": {
      "$ref": "#/$defs/ResearchBudgetAmount14",
      "title": "Year 6"
    },
    "total": {
      "$ref": "#/$defs/ResearchBudgetTotalAmount15",
      "title": "Total Tuition and Fees Requested",
      "readOnly": true
    }
  },
  "required": [
    "fundsRequested"
  ],
  "description": "Request tuition and fees for up to six fellowship years.",
  "$defs": {
    "YesNoCode": {
      "type": "string",
      "enum": [
        "Y: Yes",
        "N: No"
      ]
    },
    "ResearchBudgetAmount14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^(?:\\d{1,14}|\\d{1,13}[.]\\d|\\d{1,12}[.]\\d{2})$"
    },
    "ResearchBudgetTotalAmount15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^(?:\\d{1,15}|\\d{1,14}[.]\\d|\\d{1,13}[.]\\d{2})$"
    }
  }
}
