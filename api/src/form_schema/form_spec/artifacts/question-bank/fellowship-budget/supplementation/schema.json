{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fellowship-budget/supplementation/schema.json",
  "type": "object",
  "properties": {
    "amount": {
      "$ref": "#/$defs/ResearchBudgetAmount14",
      "title": "Supplementation Amount"
    },
    "numberOfMonths": {
      "$ref": "#/$defs/FellowshipMonthsUpTo12",
      "title": "Number of Months"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "title": "Type of Supplementation"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "title": "Source of Supplementation"
    }
  },
  "required": [
    "amount",
    "numberOfMonths",
    "type",
    "source"
  ],
  "description": "Enter stipend supplementation supplied from other sources.",
  "$defs": {
    "ResearchBudgetAmount14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^(?:\\d{1,14}|\\d{1,13}[.]\\d|\\d{1,12}[.]\\d{2})$"
    },
    "FellowshipMonthsUpTo12": {
      "type": "string",
      "pattern": "^(?:[0-9]|1[0-2])(?:[.][0-9]{1,2})?$"
    }
  }
}
