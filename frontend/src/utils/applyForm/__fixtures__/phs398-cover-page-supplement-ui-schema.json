[
  {
    "type": "section",
    "name": "vertebrate_animals",
    "label": "1. Vertebrate Animals",
    "children": [
      {
        "type": "field",
        "definition": "/properties/vertebrate_animals/properties/animal_euthanized"
      },
      {
        "type": "field",
        "definition": "/properties/vertebrate_animals/properties/avma_consistent",
        "conditional": {
          "when": {
            "op": "equals",
            "ref": {
              "scope": "root",
              "pointer": "/vertebrate_animals/animal_euthanized"
            },
            "value": "Y: Yes"
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      },
      {
        "type": "field",
        "definition": "/properties/vertebrate_animals/properties/method_description",
        "widget": "TextArea",
        "conditional": {
          "when": {
            "op": "equals",
            "ref": {
              "scope": "root",
              "pointer": "/vertebrate_animals/avma_consistent"
            },
            "value": "N: No"
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      }
    ]
  },
